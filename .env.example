GITLAB_PROJECT_ID=
# Personal or project access token with api (or read_repository + write_repository)
# Server-only — never expose this to the browser / never use NEXT_PUBLIC_ for write tokens
GITLAB_TOKEN=
GITLAB_REF=main
SITE_URL=https://anasmerstani.com

# Optional: GitLab branch used to cache prior blog HTML for incremental builds
SITE_CACHE_REF=site-cache
# Set to 1 to skip uploading the site-cache during build
# SKIP_SITE_CACHE=1

# Auto-rebuild when CMS content is pushed (set these on Vercel)
GITLAB_WEBHOOK_SECRET=
VERCEL_DEPLOY_HOOK_URL=
